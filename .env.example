APP_NAME=cargo_admin_backend
PORT=3000

# MongoDB Atlas connection string (get this from Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
DB_NAME=cargo_admin

# Use a long random string, e.g. output of: openssl rand -hex 64
JWT_SECRET=

# Created on first boot if no user with this email exists yet
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me-now
